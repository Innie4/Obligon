diff --git a/apps/api/src/scripts/grant-partner-test-access.js b/apps/api/src/scripts/grant-partner-test-access.js
new file mode 100644
index 0000000..b477e2d
--- /dev/null
+++ b/apps/api/src/scripts/grant-partner-test-access.js
@@ -0,0 +1,57 @@
+import { getPool } from "../db.js";
+import { env } from "../config/env.js";
+import { grantTemporaryPartnerAccess, TEMPORARY_PARTNER_ACCOUNT } from "../lib/temporaryPartnerAccount.js";
+
+let pool;
+function commandError(message) {
+  return Object.assign(new Error(message), { name: "PartnerGrantCommandError" });
+}
+
+// This command is operator-only. It never receives a password in argv or prints
+// one. Runtime middleware separately restricts the grant to dashboard reads.
+async function main() {
+  const flags = new Set(process.argv.slice(2));
+  if ([...flags].some((flag) => !["--apply", "--reviewed", "--help"].includes(flag))) {
+    throw commandError("Use only --apply, --reviewed or --help. Supply credentials through protected environment input.");
+  }
+  if (flags.has("--help")) {
+    console.log("Default: read-only preview. --apply grants one fixed 24-hour lease; production also requires --reviewed.");
+    console.log("The explicit apply password must be supplied through OBLIGON_PARTNER_TEST_PASSWORD; it is never printed.");
+    return;
+  }
+  if (!env.DATABASE_URL) throw commandError("DATABASE_URL is required. No changes were made.");
+  if (flags.has("--apply") && env.NODE_ENV === "production" && !flags.has("--reviewed")) {
+    throw commandError("Production apply requires --reviewed after qualified review of the exact release. No changes were made.");
+  }
+  pool = getPool();
+  if (flags.has("--apply")) {
+    const result = await grantTemporaryPartnerAccess({ password: process.env.OBLIGON_PARTNER_TEST_PASSWORD });
+    console.log(JSON.stringify({ status: result.status, startsAt: result.startsAt, expiresAt: result.expiresAt, hours: 24, access: "read-only" }));
+    return;
+  }
+  const client = await pool.connect();
+  try {
+    await client.query("BEGIN READ ONLY");
+    const { rows } = await client.query(`SELECT id,status,access_expires_at,
+      access_expires_at > clock_timestamp() AS active_grant FROM users
+      WHERE id=$1 OR lower(email)=lower($2)`, [TEMPORARY_PARTNER_ACCOUNT.userId, TEMPORARY_PARTNER_ACCOUNT.email]);
+    console.log(JSON.stringify({ mode: "dry-run", matchingIdentities: rows.length,
+      knownIdentityPresent: rows.some((row) => row.id === TEMPORARY_PARTNER_ACCOUNT.userId),
+      activeGrant: rows.some((row) => row.active_grant),
+      message: "No changes made. Full isolation and credential checks run only for an explicitly reviewed apply." }));
+    await client.query("COMMIT");
+  } catch (error) {
+    await client.query("ROLLBACK");
+    throw error;
+  } finally {
+    client.release();
+  }
+}
+
+main().catch((error) => {
+  // Provider/database errors can contain submitted values. Expose only our
+  // deliberately written validation errors; never dump errors or their detail.
+  const safe = ["TemporaryPartnerAccessError", "PartnerGrantCommandError"].includes(error.name);
+  console.error(safe ? error.message : "Partner test access command failed. Inspect protected server diagnostics; credentials were not printed.");
+  process.exitCode = 1;
+}).finally(() => pool?.end());
diff --git a/apps/api/tests/account-access.test.mjs b/apps/api/tests/account-access.test.mjs
new file mode 100644
index 0000000..bbeb12f
--- /dev/null
+++ b/apps/api/tests/account-access.test.mjs
@@ -0,0 +1,20 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { accountAccessExpired } from "../src/lib/accountAccess.js";
+
+test("ordinary accounts retain existing behavior without an access deadline", () => {
+  assert.equal(accountAccessExpired({}), false);
+  assert.equal(accountAccessExpired({ access_expires_at: null }), false);
+});
+
+test("account deadline is exclusive and does not depend on subscription or email", () => {
+  const deadline = Date.parse("2026-01-02T00:00:00.000Z");
+  const user = { access_expires_at: new Date(deadline), email: "changed@example.test", role: "partner" };
+  assert.equal(accountAccessExpired(user, deadline - 1), false);
+  assert.equal(accountAccessExpired(user, deadline), true);
+  assert.equal(accountAccessExpired(user, deadline + 1), true);
+});
+
+test("malformed configured account deadlines fail closed", () => {
+  assert.equal(accountAccessExpired({ access_expires_at: "not-a-date" }), true);
+});
