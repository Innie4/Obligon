+"use client";
+
+import { StatusPopup } from "@/components/shared/StatusPopup";
+
+import * as React from "react";
+import Link from "next/link";
+import { ArrowLeft, Fingerprint, KeyRound, Loader2 } from "lucide-react";
+import { authApi } from "@/lib/services";
+import { authMethodError, passkeySupportError, registerDevicePasskey, type AuthMethodsConfig, type GoogleChallenge, type SignInMethods } from "@/lib/auth-methods";
+import { dashboardDestination } from "@/lib/auth-routing";
+import { useSession } from "@/components/shared/AuthContext";
+import { GoogleIdentityButton } from "./GoogleIdentityButton";
+
+const fieldClass = "mt-2 min-h-12 w-full min-w-0 rounded-xl border border-obligon-border bg-white px-3 text-base text-obligon-navy focus:outline-none focus:ring-2 focus:ring-obligon-green disabled:opacity-50";
+const actionClass = "inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-obligon-green px-4 py-2 text-sm font-bold text-obligon-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-obligon-green disabled:cursor-not-allowed disabled:opacity-50";
+
+export function SignInOptions() {
+  const { user } = useSession();
+  const [data, setData] = React.useState<SignInMethods | null>(null);
+  const [config, setConfig] = React.useState<AuthMethodsConfig | null>(null);
+  const [password, setPassword] = React.useState("");
+  const [label, setLabel] = React.useState("My device");
+  const [busy, setBusy] = React.useState<string | null>(null);
+  const [loading, setLoading] = React.useState(true);
+  const [error, setError] = React.useState<string | null>(null);
+  const [notice, setNotice] = React.useState<string | null>(null);
+  const [linkChallenge, setLinkChallenge] = React.useState<GoogleChallenge | null>(null);
+  const [removeId, setRemoveId] = React.useState<string | null>(null);
+  const [unsupported, setUnsupported] = React.useState<string | null>(null);
+  const active = React.useRef(true);
+  const inFlight = React.useRef(false);
+  const requestGeneration = React.useRef(0);
+  const actionGeneration = React.useRef(0);
+
+  const reload = React.useCallback(async () => {
+    const generation = ++requestGeneration.current;
+    setLoading(true);
+    try {
+      const [methods, methodsConfig] = await Promise.all([authApi.signInMethods(), authApi.methodsConfig()]);
+      if (active.current && generation === requestGeneration.current) { setData(methods); setConfig(methodsConfig); }
+    } catch (failure) { if (active.current && generation === requestGeneration.current) setError(authMethodError(failure)); }
+    finally { if (active.current && generation === requestGeneration.current) setLoading(false); }
+  }, [user?.id]);
+
+  React.useEffect(() => {
+    active.current = true;
+    setData(null);
+    setConfig(null);
+    setPassword("");
+    setLabel("My device");
+    inFlight.current = false;
+    setBusy(null);
+    setRemoveId(null);
+    setError(null);
+    setNotice(null);
+    setLinkChallenge(null);
+    setUnsupported(passkeySupportError());
+    void reload();
+    return () => { active.current = false; requestGeneration.current += 1; actionGeneration.current += 1; };
+  }, [reload]);
+
+  async function withPassword<T>(action: string, operation: (currentPassword: string) => Promise<T>): Promise<T | undefined> {
+    if (inFlight.current || !password) return;
+    inFlight.current = true;
+    const generation = ++actionGeneration.current;
+    const currentPassword = password;
+    setPassword("");
+    setBusy(action);
+    setError(null);
+    setNotice(null);
+    try {
+      const result = await operation(currentPassword);
+      return active.current && generation === actionGeneration.current ? result : undefined;
+    } catch (failure) { if (active.current && generation === actionGeneration.current) setError(authMethodError(failure)); }
+    finally { if (active.current && generation === actionGeneration.current) { inFlight.current = false; setBusy(null); } }
+  }
+
+  async function beginGoogleLink() {
+    const challenge = await withPassword("google-start", value => authApi.googleLinkStart(value));
+    if (challenge) { setLinkChallenge(challenge); setNotice("Choose your Google account using the button below."); }
+  }
+  const prepareGoogle = React.useCallback(async () => {
+    if (!linkChallenge) throw new Error("Confirm your password to start again.");
+    return linkChallenge;
+  }, [linkChallenge]);
+  const finishGoogle = React.useCallback(async (challenge: GoogleChallenge, credential: string) => {
+    if (inFlight.current) return;
+    inFlight.current = true;
+    const generation = ++actionGeneration.current;
+    setBusy("google-finish");
+    setError(null);
+    try {
+      const result = await authApi.googleLinkFinish(challenge, credential);
+      if (!result.ok) throw new Error("Google could not be linked. Confirm your password and try again.");
+      if (active.current && generation === actionGeneration.current) { setLinkChallenge(null); setNotice("Google is linked to your account."); await reload(); }
+    } catch (failure) {
+      if (active.current && generation === actionGeneration.current) { setLinkChallenge(null); setError(`${authMethodError(failure)} Confirm your password to start again.`); }
+      throw failure;
+    } finally { if (active.current && generation === actionGeneration.current) { inFlight.current = false; setBusy(null); } }
+  }, [reload]);
+  async function unlinkGoogle() {
+    const result = await withPassword("google-remove", value => authApi.unlinkGoogle(value));
+    if (result?.ok) { setLinkChallenge(null); setNotice("Google has been unlinked. Your other sessions have been signed out."); await reload(); }
+  }
+  async function addPasskey() {
+    if (!config?.passkeys.enabled || unsupported || !label.trim()) return;
+    const result = await withPassword("passkey-add", value => authApi.registerPasskey(value, label.trim(), registerDevicePasskey));
+    if (result?.ok) { setLabel("My device"); setNotice("Passkey added. You can use it on the sign-in page."); await reload(); }
+  }
+  async function removePasskey(id: string) {
+    const result = await withPassword(`passkey-remove-${id}`, value => authApi.removePasskey(id, value));
+    if (result?.ok) { setRemoveId(null); setNotice("Passkey removed. Your other sessions have been signed out."); await reload(); }
+  }
+
+  const googleEnabled = Boolean(config?.google.enabled && config.google.clientId && data?.google.enabled);
+  const actionsDisabled = Boolean(busy) || loading || !password;
+  return <div className="w-full min-w-0 max-w-3xl space-y-6">
+    <Link href={dashboardDestination(user?.role)} className="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-obligon-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-obligon-green"><ArrowLeft size={18} aria-hidden="true" />Back to dashboard</Link>
+    <header><h1 className="font-display text-3xl font-extrabold text-obligon-navy">Sign-in options</h1><p className="mt-3 text-base leading-6 text-obligon-text">Link Google or add a passkey to this existing account. Your password remains available.</p></header>
+    {error ? <StatusPopup tone="error" message={error} /> : null}
+    {notice ? <StatusPopup tone="info" message={notice} /> : null}
+    {busy ? <StatusPopup tone="pending" message="Updating your sign-in options…" /> : null}
+    {loading && !data ? <StatusPopup tone="loading" message="Loading sign-in options…" /> : !data ? <button type="button" className={actionClass} onClick={() => void reload()}>Retry loading sign-in options</button> : <>
+      <section aria-labelledby="confirm-password-title" className="rounded-2xl border border-obligon-border bg-white p-5 sm:p-6">
+        <h2 id="confirm-password-title" className="flex items-center gap-2 text-lg font-bold"><KeyRound size={20} aria-hidden="true" />Confirm it is you</h2>
+        <p id="method-password-help" className="mt-2 text-sm leading-6 text-obligon-text">Enter your current password before adding or removing a sign-in method. We clear this field after each request. Removing a method signs out your other sessions. This session stays signed in.</p>
+        <label htmlFor="method-current-password" className="mt-4 block text-sm font-bold">Current password</label><input id="method-current-password" type="password" autoComplete="current-password" value={password} onChange={event => setPassword(event.target.value)} disabled={Boolean(busy)} aria-describedby="method-password-help" className={fieldClass} />
+      </section>
+      <section aria-labelledby="google-options-title" className="min-w-0 rounded-2xl border border-obligon-border bg-white p-5 sm:p-6">
+        <h2 id="google-options-title" className="text-xl font-bold">Google</h2>
+        <p className="mt-2 text-sm leading-6 text-obligon-text">{data.google.linked ? "A Google account is linked to this Obligon account." : "Link your Google account after confirming your password. This will not create a new Obligon account."}</p>
+        {data.google.linked ? <><button type="button" onClick={() => void unlinkGoogle()} disabled={actionsDisabled} className={`mt-4 ${actionClass}`}>Unlink Google</button>{!googleEnabled ? <p className="mt-3 text-sm text-obligon-text">Google sign-in is currently unavailable. You can still unlink the saved account with your password.</p> : null}</> : !googleEnabled ? <p className="mt-3 text-sm text-obligon-text">Google sign-in is not configured for this deployment.</p> : linkChallenge ? <div className="mt-4 space-y-3"><GoogleIdentityButton prepare={prepareGoogle} onCredential={finishGoogle} disabled={Boolean(busy)} text="continue_with" /><button type="button" onClick={() => { setLinkChallenge(null); setNotice(null); }} disabled={Boolean(busy)} className={actionClass}>Cancel linking</button></div> : <button type="button" onClick={() => void beginGoogleLink()} disabled={actionsDisabled} className={`mt-4 ${actionClass}`}>Verify password to continue</button>}
+      </section>
+      <section aria-labelledby="passkey-options-title" className="min-w-0 rounded-2xl border border-obligon-border bg-white p-5 sm:p-6">
+        <h2 id="passkey-options-title" className="flex items-center gap-2 text-xl font-bold"><Fingerprint size={22} aria-hidden="true" />Passkeys</h2>
+        <p className="mt-2 text-sm leading-6 text-obligon-text">Your device may use a fingerprint, Face ID or device PIN. Biometric data stays on your device.</p>
+        {config?.passkeys.enabled ? <><label htmlFor="passkey-label" className="mt-4 block text-sm font-bold">Passkey name</label><input id="passkey-label" value={label} onChange={event => setLabel(event.target.value)} maxLength={80} disabled={Boolean(busy)} className={fieldClass} /><button type="button" onClick={() => void addPasskey()} disabled={actionsDisabled || Boolean(unsupported) || !label.trim()} className={`mt-4 ${actionClass}`}>{busy === "passkey-add" ? <Loader2 size={16} className="animate-spin" aria-hidden="true" /> : null}Add a passkey</button>{unsupported ? <p className="mt-3 text-sm text-obligon-text">{unsupported}</p> : null}</> : <p className="mt-3 text-sm text-obligon-text">Passkeys are not enabled on this deployment.</p>}
+        {data.passkeys.length ? <ul className="mt-6 divide-y divide-obligon-border">{data.passkeys.map(passkey => <li key={passkey.id} className="space-y-3 py-4"><div className="flex min-w-0 flex-wrap items-center justify-between gap-3"><div className="min-w-0"><h3 className="break-words font-bold">{passkey.label}</h3><p className="mt-1 text-xs leading-5 text-obligon-text">Added {new Date(passkey.createdAt).toLocaleDateString("en-GB")} · {passkey.lastUsedAt ? `Last used ${new Date(passkey.lastUsedAt).toLocaleDateString("en-GB")}` : "Not used yet"}</p></div><button type="button" onClick={() => setRemoveId(passkey.id)} aria-expanded={removeId === passkey.id} disabled={Boolean(busy)} className={actionClass}>Remove</button></div>{removeId === passkey.id ? <div className="space-y-3 rounded-xl bg-obligon-mist p-4"><p className="text-sm">Remove “{passkey.label}”? Confirm your current password above, then remove this passkey.</p><div className="flex flex-wrap gap-3"><button type="button" onClick={() => void removePasskey(passkey.id)} disabled={actionsDisabled} className={actionClass}>Remove this passkey</button><button type="button" onClick={() => setRemoveId(null)} disabled={Boolean(busy)} className={actionClass}>Cancel</button></div></div> : null}</li>)}</ul> : <p className="mt-5 text-sm text-obligon-text">{config?.passkeys.enabled ? "No passkeys added. Confirm your password and add a passkey on a device you use." : "No passkeys added."}</p>}
+      </section>
+    </>}
+  </div>;
+}
diff --git a/apps/web/components/dashboard/WorkshopDashboard.tsx b/apps/web/components/dashboard/WorkshopDashboard.tsx
new file mode 100644
index 0000000..60f2b54
--- /dev/null
+++ b/apps/web/components/dashboard/WorkshopDashboard.tsx
@@ -0,0 +1,106 @@
+"use client";
+
+import { StatusPopup } from "@/components/shared/StatusPopup";
+import Link from "next/link";
+import * as React from "react";
+import { useSession } from "@/components/shared/AuthContext";
+import { AsyncBoundary } from "@/components/shared/States";
+import { useAsync } from "@/components/shared/useAsync";
+import { authenticatedRequest } from "@/lib/services";
+import { workshopServices, type WorkshopData, type WorkshopProfile } from "@/lib/partner-workshop";
+
+const fieldClass = "mt-2 block min-h-12 w-full rounded-xl border border-obligon-border bg-white px-4 py-3 text-sm text-obligon-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-obligon-green disabled:bg-obligon-mist";
+
+function WorkshopEditor({ profile, canEdit, onSaved }: { profile: WorkshopProfile; canEdit: boolean; onSaved: () => void }) {
+  const [draft, setDraft] = React.useState(profile);
+  const [saving, setSaving] = React.useState(false);
+  const [error, setError] = React.useState("");
+  const [saved, setSaved] = React.useState(false);
+  const submitting = React.useRef(false);
+  const options = [...new Set<string>([...workshopServices, ...profile.services])];
+  const change = <K extends keyof WorkshopProfile>(key: K, value: WorkshopProfile[K]) => {
+    setDraft(current => ({ ...current, [key]: value }));
+    setSaved(false);
+  };
+
+  async function submit(event: React.FormEvent) {
+    event.preventDefault();
+    if (!canEdit || submitting.current) return;
+    submitting.current = true;
+    setSaving(true); setError(""); setSaved(false);
+    try {
+      await authenticatedRequest("/api/partner/workshop", { method: "PUT", body: JSON.stringify(draft) });
+      setSaved(true);
+      onSaved();
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Your workshop profile could not be saved. Please try again.");
+    } finally {
+      submitting.current = false;
+      setSaving(false);
+    }
+  }
+
+  return <form onSubmit={submit} className="mt-6 max-w-4xl space-y-6 rounded-2xl border border-obligon-border bg-white p-5 sm:p-8">
+      {(saving) ? <StatusPopup tone="pending" message="Saving workshop profile…" /> : null}
+    {!canEdit ? <p className="rounded-lg bg-obligon-mist p-4 text-sm text-obligon-text">Your team can view this profile. An owner or administrator can update it.</p> : null}
+    <fieldset disabled={!canEdit || saving} className="grid gap-5 sm:grid-cols-2">
+      <legend className="font-display text-lg font-bold tracking-tight sm:text-xl text-obligon-navy">Workshop details</legend>
+      {([
+        ["name", "Workshop name", 200], ["address", "Street address", 500],
+        ["city", "City / town", 200], ["website", "Website (optional)", 500]
+      ] as const).map(([name, label, limit]) => <label key={name} className="block text-sm font-bold text-obligon-navy">
+        {label}<input name={name} value={draft[name]} onChange={event => change(name, event.target.value)} required={name === "name"} type={name === "website" ? "url" : "text"} autoComplete={name === "address" ? "street-address" : name === "city" ? "address-level2" : name === "website" ? "url" : "organization"} maxLength={limit} className={fieldClass} />
+      </label>)}
+      <label className="block text-sm font-semibold text-obligon-navy sm:col-span-2">About your workshop
+        <textarea name="description" value={draft.description} onChange={event => change("description", event.target.value)} maxLength={2000} rows={4} className={fieldClass} />
+      </label>
+      <fieldset className="sm:col-span-2"><legend className="text-sm font-semibold text-obligon-navy">Services offered</legend>
+        <div className="mt-2 grid gap-2 sm:grid-cols-2">{options.map(service => <label key={service} className="flex min-h-12 items-center gap-3 rounded-xl border border-obligon-border px-4 py-3 text-sm text-obligon-navy transition-colors has-[:checked]:border-obligon-green has-[:checked]:bg-obligon-mist">
+          <input type="checkbox" checked={draft.services.includes(service)} onChange={event => change("services", event.target.checked ? [...draft.services, service] : draft.services.filter(value => value !== service))} className="size-4 accent-obligon-green" />{service}
+        </label>)}</div>
+      </fieldset>
+    </fieldset>
+    {error ? <StatusPopup tone="error" message={error} /> : null}
+    {saved ? <p role="status" className="rounded-lg bg-obligon-mist p-4 text-sm font-bold text-obligon-green">Workshop profile saved.</p> : null}
+    {canEdit ? <button type="submit" disabled={saving} className="min-h-12 rounded-xl bg-obligon-green px-5 font-bold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-obligon-green disabled:opacity-60">{saving ? "Saving…" : "Save workshop profile"}</button> : null}
+  </form>;
+}
+
+export function WorkshopDashboard({ edit = false }: { edit?: boolean }) {
+  const { user } = useSession();
+  const { status, data, error, reload } = useAsync(() => authenticatedRequest<WorkshopData>("/api/partner/workshop"));
+  const canEdit = user?.organizationRole === "owner" || user?.organizationRole === "admin";
+  return <section className="mx-auto w-full max-w-[1440px] min-w-0 px-4 py-6 sm:px-8 sm:py-8 lg:px-12 lg:py-10">
+    <h1 className="font-display text-2xl font-bold tracking-tight sm:text-3xl text-obligon-navy">{edit ? "Workshop profile" : "Workshop overview"}</h1>
+    <p className="mt-2 max-w-2xl text-sm text-obligon-text">{edit ? "Keep your workshop contact details and services up to date." : "Manage your workshop profile, team and support requests."}</p>
+    <AsyncBoundary status={status} error={error?.message ?? null} onRetry={reload} loadingLabel="Loading your workshop…">
+      {data ? edit ? <WorkshopEditor key={user?.organizationId} profile={data.profile} canEdit={canEdit} onSaved={reload} /> : <>
+        <article className="mt-8 rounded-2xl border border-obligon-border bg-white p-6 sm:p-8">
+          <h2 className="break-words font-display text-2xl font-bold text-obligon-navy">{data.profile.name}</h2>
+          <p className="mt-2 text-sm text-obligon-text">{[data.profile.address, data.profile.city].filter(Boolean).join(", ") || "Add your workshop address in Workshop Profile."}</p>
+          {data.profile.description ? <p className="mt-4 max-w-3xl text-sm leading-6 text-obligon-text">{data.profile.description}</p> : null}
+          <Link href="/dashboard/workshop" className="mt-5 inline-flex min-h-11 items-center font-bold text-obligon-green underline">View workshop profile</Link>
+          <h3 className="mt-6 text-sm font-bold text-obligon-navy">Services offered</h3>
+          {data.profile.services.length ? <ul className="mt-3 flex flex-wrap gap-2">{data.profile.services.map(service => <li key={service} className="rounded-lg bg-obligon-mist px-3 py-2 text-sm text-obligon-navy">{service}</li>)}</ul> : <p className="mt-2 text-sm text-obligon-text">No services have been added yet.</p>}
+        </article>
+        <div className="mt-6 grid gap-4 sm:grid-cols-2">
+          <Link href="/dashboard/staff" className="min-w-0 rounded-2xl border border-obligon-border bg-white p-6 transition-colors hover:border-obligon-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-obligon-green"><p className="text-sm font-bold text-obligon-text">Team members</p><p className="mt-2 text-3xl font-extrabold text-obligon-navy">{data.stats.staff}</p><p className="mt-3 text-sm font-bold text-obligon-green">View your team</p></Link>
+          <Link href="/dashboard/settings#partner-support" className="min-w-0 rounded-2xl border border-obligon-border bg-white p-6 transition-colors hover:border-obligon-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-obligon-green"><p className="text-sm font-bold text-obligon-text">Support requests</p><p className="mt-2 text-3xl font-extrabold text-obligon-navy">{data.stats.supportTickets}</p><p className="mt-3 text-sm font-bold text-obligon-green">Open Support</p></Link>
+        </div>
+        <p className="mt-6 text-sm text-obligon-text">Job bookings and service payments are not available in this dashboard.</p>
+      </> : null}
+    </AsyncBoundary>
+  </section>;
+}
+
+export function PartnerAccountOverview() {
+  const { user } = useSession();
+  return <section className="mx-auto w-full max-w-[1440px] min-w-0 px-4 py-6 sm:px-8 sm:py-8 lg:px-12 lg:py-10">
+    <h1 className="font-display text-2xl font-bold tracking-tight sm:text-3xl text-obligon-navy">Partner account</h1>
+    <article className="mt-6 max-w-3xl rounded-xl border border-obligon-border bg-white p-6 sm:p-8">
+      <h2 className="break-words font-display text-xl font-bold text-obligon-navy">{user?.organization || "Your business"}</h2>
+      <p className="mt-3 text-sm leading-6 text-obligon-text">Your partner specialization needs admin review before operational features can be enabled. Keep your account details current and contact Support to confirm the services your business provides.</p>
+      <div className="mt-5 flex flex-wrap gap-4"><Link href="/dashboard/settings#partner-support" className="inline-flex min-h-12 items-center font-bold text-obligon-green underline">Open Support</Link><Link href="/dashboard/verify" className="inline-flex min-h-12 items-center font-bold text-obligon-green underline">Account verification</Link></div>
+    </article>
+  </section>;
+}
diff --git a/apps/web/components/shared/DashboardSearch.tsx b/apps/web/components/shared/DashboardSearch.tsx
new file mode 100644
index 0000000..132175e
--- /dev/null
+++ b/apps/web/components/shared/DashboardSearch.tsx
@@ -0,0 +1,129 @@
+"use client";
+
+import Link from "next/link";
+import { usePathname, useRouter } from "next/navigation";
+import * as React from "react";
+import { createPortal } from "react-dom";
+import { ArrowUpRight, Loader2, Search, X } from "lucide-react";
+import { useSession } from "./AuthContext";
+import { useDialogFocus } from "./useDialogFocus";
+import { DashboardSearchUnavailableError, searchDashboardRecords, type DashboardSearchResult, type DashboardSearchScope } from "@/lib/dashboard-search";
+
+export type DashboardSearchEntry = { href: string; label: string; keywords?: string };
+
+function allowedHref(href: string, scope: DashboardSearchScope) {
+  if (!href.startsWith("/") || href.startsWith("//") || /[\\\s\u0000-\u001f]/.test(href)) return false;
+  const path = href.split(/[?#]/, 1)[0];
+  const prefix = scope === "partner" ? "/dashboard" : `/${scope}`;
+  return path === prefix || path.startsWith(`${prefix}/`) || path === "/auth/sign-in-options" || path === "/support";
+}
+
+export function DashboardSearch({ scope, entries, className = "", compact = false }: {
+  scope: DashboardSearchScope;
+  entries: readonly DashboardSearchEntry[];
+  className?: string;
+  compact?: boolean;
+}) {
+  const { user } = useSession();
+  const router = useRouter();
+  const pathname = usePathname();
+  const id = React.useId();
+  const listId = `${id}-results`;
+  const inputRef = React.useRef<HTMLInputElement>(null);
+  const mobileInputRef = React.useRef<HTMLInputElement>(null);
+  const dialogRef = React.useRef<HTMLElement>(null);
+  const request = React.useRef(0);
+  const [query, setQuery] = React.useState("");
+  const [mode, setMode] = React.useState<"desktop" | "mobile" | null>(null);
+  const [active, setActive] = React.useState(-1);
+  const [retry, setRetry] = React.useState(0);
+  const [remote, setRemote] = React.useState<{ owner: string; query: string; status: "loading" | "ready" | "error"; items: DashboardSearchResult[]; partial?: boolean } | null>(null);
+  const owner = [scope, user?.id, user?.role, user?.organizationId, user?.organizationType, user?.organizationRole, user?.organizationVerificationStatus, user?.partnerType].join(":");
+  const normalized = query.trim().toLowerCase();
+  const open = mode !== null;
+  const close = React.useCallback(() => { setMode(null); setQuery(""); setActive(-1); }, []);
+  useDialogFocus(dialogRef, close, mode === "mobile");
+
+  React.useEffect(() => { close(); setRemote(null); }, [owner, pathname, close]);
+  React.useEffect(() => { if (mode === "mobile") mobileInputRef.current?.focus(); }, [mode]);
+  React.useEffect(() => {
+    const revision = ++request.current;
+    setActive(-1);
+    if (!open || !user || normalized.length < 2) { setRemote(null); return; }
+    let current = true;
+    setRemote({ owner, query: normalized, status: "loading", items: [] });
+    const timer = window.setTimeout(() => {
+      void searchDashboardRecords(scope, normalized, user).then(items => {
+        if (current && request.current === revision) setRemote({ owner, query: normalized, status: "ready", items });
+      }).catch(error => {
+        if (!current || request.current !== revision) return;
+        const partial = error instanceof DashboardSearchUnavailableError;
+        setRemote({ owner, query: normalized, status: "error", items: partial ? error.results : [], partial });
+      });
+    }, 250);
+    return () => { current = false; window.clearTimeout(timer); };
+  }, [open, normalized, owner, retry, scope, user]);
+
+  const nav = entries.filter(item => allowedHref(item.href, scope) && normalized.split(/\s+/).every(word => `${item.label} ${item.href} ${item.keywords ?? ""}`.toLowerCase().includes(word))).map(item => ({ ...item, id: `page:${item.href}`, description: "Page", kind: "Page" }));
+  const currentRemote = remote?.owner === owner && remote.query === normalized ? remote : null;
+  const unique = new Map<string, DashboardSearchResult>();
+  for (const item of [...nav, ...(currentRemote?.items ?? [])]) if (allowedHref(item.href, scope) && !unique.has(item.href)) unique.set(item.href, item);
+  const results = [...unique.values()].slice(0, 30);
+  const selected = active >= 0 && active < results.length ? active : -1;
+  const loading = open && normalized.length >= 2 && (!currentRemote || currentRemote.status === "loading");
+
+  function select(item: DashboardSearchResult, event?: React.MouseEvent<HTMLAnchorElement>) {
+    if (event && (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button > 0)) return;
+    const currentRecord = !item.id.startsWith("page:") && item.href === `${window.location.pathname}${window.location.search}`;
+    close();
+    if (currentRecord) { event?.preventDefault(); window.location.assign(item.href); }
+    else if (!event) router.push(item.href);
+  }
+
+  function keyDown(event: React.KeyboardEvent<HTMLInputElement>) {
+    if (event.key === "Escape") { event.preventDefault(); close(); inputRef.current?.blur(); return; }
+    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
+      event.preventDefault();
+      if (!open) setMode("desktop");
+      if (results.length) setActive(index => event.key === "ArrowDown" ? (index + 1) % results.length : index <= 0 ? results.length - 1 : index - 1);
+    } else if (event.key === "Enter" && open && results.length) {
+      event.preventDefault();
+      const result = results[selected < 0 ? 0 : selected];
+      select(result);
+    }
+  }
+
+  React.useEffect(() => {
+    if (selected >= 0 && open) document.getElementById(`${listId}-${selected}`)?.scrollIntoView?.({ block: "nearest" });
+  }, [selected, open, listId]);
+
+  function field(mobile: boolean) {
+    return <div className="flex min-h-11 min-w-0 items-center gap-2 rounded-xl border border-obligon-border bg-white px-3 focus-within:ring-2 focus-within:ring-obligon-green focus-within:ring-offset-2">
+      <Search size={18} className="shrink-0 text-obligon-text" aria-hidden="true" />
+      <input ref={mobile ? mobileInputRef : inputRef} value={query} maxLength={80} type="text" inputMode="search" enterKeyHint="search" autoComplete="off" spellCheck={false} placeholder="Search pages and recent records" aria-label={`Search ${scope} dashboard`} role="combobox" aria-expanded={open} aria-controls={open ? listId : undefined} aria-autocomplete="list" aria-activedescendant={open && selected >= 0 ? `${listId}-${selected}` : undefined} onFocus={() => { if (!mobile) setMode("desktop"); }} onChange={event => { setQuery(event.target.value); setActive(-1); }} onKeyDown={keyDown} className="min-h-11 w-full min-w-0 bg-transparent text-base text-obligon-navy outline-none focus-visible:outline-none placeholder:text-obligon-text md:text-sm" />
+      {query ? <button type="button" onClick={() => { setQuery(""); setActive(-1); (mobile ? mobileInputRef : inputRef).current?.focus(); }} aria-label="Clear search" className="grid min-h-11 min-w-11 shrink-0 place-items-center rounded-lg text-obligon-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-obligon-green"><X size={17} aria-hidden="true" /></button> : null}
+    </div>;
+  }
+
+  function resultList() {
+    return <>
+      <div className="border-b border-obligon-border px-4 py-3 text-xs leading-5 text-obligon-text" aria-live="polite">
+        {loading ? <span className="flex items-center gap-2" role="status"><Loader2 size={14} aria-hidden="true" className="animate-spin motion-reduce:animate-none" />Searching records...</span> : normalized.length < 2 ? "Choose a page, or type at least 2 characters to find records." : <span role="status">{results.length} {results.length === 1 ? "result" : "results"}</span>}
+      </div>
+      {currentRemote?.status === "error" ? <div className="border-b border-obligon-border px-4 py-3"><p role="alert" className="text-sm leading-5 text-red-700">{currentRemote.partial && currentRemote.items.length ? "Some records could not be searched. Available results are shown." : "Records could not be searched. You can still open matching pages."}</p><button type="button" onClick={() => setRetry(value => value + 1)} className="mt-1 min-h-11 font-bold text-obligon-green underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-obligon-green">Retry search</button></div> : null}
+      <ul id={listId} role="listbox" aria-label="Search results" className="max-h-[min(56vh,420px)] overflow-y-auto p-2">
+        {results.map((item, index) => <li key={item.href} role="none"><Link id={`${listId}-${index}`} href={item.href} role="option" aria-selected={selected === index} tabIndex={-1} onMouseDown={event => event.preventDefault()} onMouseEnter={() => setActive(index)} onClick={event => select(item, event)} className={`flex min-h-12 min-w-0 items-center gap-3 rounded-lg px-3 py-2 ${selected === index ? "bg-obligon-mist text-obligon-green" : "text-obligon-navy hover:bg-obligon-mist"}`}><span className="min-w-0 flex-1"><span className="block break-words text-sm font-bold">{item.label}</span>{item.description ? <span className="mt-0.5 block break-words text-xs leading-5 text-obligon-text">{item.description}</span> : null}</span><ArrowUpRight size={17} className="shrink-0" aria-hidden="true" /></Link></li>)}
+      </ul>
+      {!results.length && !loading ? <p role="status" className="px-4 pb-5 text-sm text-obligon-text">{currentRemote?.status === "error" ? "No matching pages. Retry to search records." : "No matching pages or records. Try another name or reference."}</p> : null}
+    </>;
+  }
+
+  return <div className={`min-w-0 ${compact ? "" : "w-auto md:w-full md:max-w-[360px]"} ${className}`}>
+    <button type="button" onClick={() => setMode("mobile")} aria-label={`Search ${scope} dashboard`} aria-haspopup="dialog" aria-expanded={mode === "mobile"} className={`grid size-11 shrink-0 place-items-center rounded-xl border border-obligon-border bg-white text-obligon-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-obligon-green ${compact ? "" : "md:hidden"}`}><Search size={20} aria-hidden="true" /></button>
+    {!compact ? <div className="relative hidden min-w-0 md:block" onBlur={event => { if (!event.currentTarget.contains(event.relatedTarget as Node | null)) setMode(current => current === "desktop" ? null : current); }}>
+      {field(false)}
+      {mode === "desktop" ? <div className="absolute left-0 right-0 top-[calc(100%+8px)] z-50 overflow-hidden rounded-xl border border-obligon-border bg-white shadow-hero">{resultList()}</div> : null}
+    </div> : null}
+    {mode === "mobile" && typeof document !== "undefined" ? createPortal(<div className="fixed inset-0 z-[100] flex items-start justify-center bg-obligon-navy/50 p-3 pt-[max(16px,env(safe-area-inset-top))] sm:p-6" onMouseDown={close}><section ref={dialogRef} role="dialog" aria-modal="true" aria-labelledby={`${id}-title`} tabIndex={-1} onMouseDown={event => event.stopPropagation()} className="max-h-[calc(100dvh-32px)] w-full max-w-xl overflow-y-auto rounded-2xl border border-obligon-border bg-white shadow-hero outline-none"><div className="flex items-center justify-between gap-3 px-4 pb-2 pt-3"><h2 id={`${id}-title`} className="text-lg font-extrabold text-obligon-navy">Search dashboard</h2><button type="button" onClick={close} aria-label="Close search" className="grid size-11 shrink-0 place-items-center rounded-lg text-obligon-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-obligon-green"><X size={20} aria-hidden="true" /></button></div><div className="px-4 pb-3">{field(true)}</div>{resultList()}</section></div>, document.body) : null}
+  </div>;
+}
diff --git a/apps/web/components/shared/DashboardSearchQuery.tsx b/apps/web/components/shared/DashboardSearchQuery.tsx
new file mode 100644
index 0000000..7ecc7b2
--- /dev/null
+++ b/apps/web/components/shared/DashboardSearchQuery.tsx
@@ -0,0 +1,22 @@
+"use client";
+
+import * as React from "react";
+import { usePathname, useSearchParams } from "next/navigation";
+
+type SearchQueryProps = { onSearch: (search: string) => void };
+
+function SearchQueryReader({ onSearch }: SearchQueryProps) {
+  const pathname = usePathname();
+  const params = useSearchParams();
+  const search = (params?.get("search") ?? "").trim().slice(0, 254);
+  const applySearch = React.useRef(onSearch);
+  applySearch.current = onSearch;
+
+  // A changed URL applies its filter. Ordinary renders keep the user's edits.
+  React.useEffect(() => { applySearch.current(search); }, [pathname, search]);
+  return null;
+}
+
+export function DashboardSearchQuery(props: SearchQueryProps) {
+  return <React.Suspense fallback={null}><SearchQueryReader {...props} /></React.Suspense>;
+}
diff --git a/apps/web/components/shared/StatusPopup.tsx b/apps/web/components/shared/StatusPopup.tsx
new file mode 100644
index 0000000..64e322e
--- /dev/null
+++ b/apps/web/components/shared/StatusPopup.tsx
@@ -0,0 +1,143 @@
+"use client";
+
+import * as React from "react";
+import { createPortal } from "react-dom";
+import { AlertTriangle, CheckCircle2, Clock3, Info, Loader2, X, XCircle, type LucideProps } from "lucide-react";
+
+export type StatusPopupTone = "loading" | "pending" | "error" | "success" | "warning" | "info";
+
+export interface StatusPopupProps {
+  tone: StatusPopupTone;
+  title?: string;
+  message?: string;
+  onRetry?: () => void;
+  retryLabel?: string;
+  action?: React.ReactNode;
+  dismissible?: boolean;
+  icon?: React.ComponentType<LucideProps>;
+}
+
+type PopupItem = StatusPopupProps & { id: string; host: HTMLElement; dismissed?: boolean };
+type PopupGroup = PopupItem & { ids: string[] };
+const PopupContext = React.createContext<{
+  register: (item: PopupItem) => void;
+  remove: (id: string) => void;
+} | null>(null);
+
+const tones: Record<StatusPopupTone, { icon: React.ComponentType<LucideProps>; color: string; border: string; title: string }> = {
+  loading: { icon: Loader2, color: "text-obligon-green", border: "border-obligon-green/30", title: "Please wait" },
+  pending: { icon: Clock3, color: "text-[#9a6300]", border: "border-[#c98a00]/40", title: "Request pending" },
+  error: { icon: XCircle, color: "text-[#b42318]", border: "border-[#c1121f]/35", title: "Something went wrong" },
+  success: { icon: CheckCircle2, color: "text-obligon-green", border: "border-obligon-green/30", title: "Complete" },
+  warning: { icon: AlertTriangle, color: "text-[#9a6300]", border: "border-[#c98a00]/40", title: "Please check" },
+  info: { icon: Info, color: "text-obligon-blue", border: "border-obligon-blue/30", title: "Update" }
+};
+
+const isProgress = (item: StatusPopupProps) => item.tone === "loading" || item.tone === "pending";
+const priority: Record<StatusPopupTone, number> = { error: 0, warning: 1, pending: 2, loading: 3, success: 4, info: 5 };
+
+function sameFeedback(a: StatusPopupProps, b: StatusPopupProps) {
+  return sameNoticeState(a, b) && a.onRetry === b.onRetry && a.action === b.action;
+}
+
+function sameNoticeState(a: StatusPopupProps, b: StatusPopupProps) {
+  return a.tone === b.tone && a.title === b.title && a.message === b.message &&
+    a.retryLabel === b.retryLabel && a.dismissible === b.dismissible && a.icon === b.icon;
+}
+
+/** Equal messages share a card; independent retry actions remain separate. */
+function groupFeedback(items: PopupItem[]) {
+  const groups: PopupGroup[] = [];
+  for (const item of items) {
+    if (item.dismissed) continue;
+    const existing = groups.find(group => group.host === item.host && sameFeedback(group, item));
+    if (existing) existing.ids.push(item.id);
+    else groups.push({ ...item, ids: [item.id] });
+  }
+  return groups.sort((a, b) => priority[a.tone] - priority[b.tone]);
+}
+
+function PopupCard({ popup, onDismiss, otherProgress = 0 }: { popup: StatusPopupProps; onDismiss: () => void; otherProgress?: number }) {
+  const config = tones[popup.tone];
+  const Icon = popup.icon ?? config.icon;
+  return (
+    <section role={popup.tone === "error" ? "alert" : "status"} aria-live={popup.tone === "error" ? "assertive" : "polite"} aria-atomic="true"
+      data-status-popup={popup.tone}
+      className={`pointer-events-auto flex items-start gap-3 rounded-2xl border ${config.border} bg-white p-4 text-left shadow-hero`}>
+      <Icon size={21} aria-hidden="true" className={`mt-0.5 shrink-0 ${config.color} ${popup.tone === "loading" ? "animate-spin motion-reduce:animate-none" : ""}`} />
+      <div className="min-w-0 flex-1">
+        <p className="break-words text-sm font-bold leading-6 text-obligon-navy">{popup.title ?? config.title}</p>
+        {popup.message ? <p className="mt-1 whitespace-pre-line break-words text-sm leading-6 text-obligon-text">{popup.message}</p> : null}
+        {otherProgress ? <p className="mt-1 text-xs leading-5 text-obligon-text">{otherProgress} other {otherProgress === 1 ? "request is" : "requests are"} in progress.</p> : null}
+        {popup.onRetry || popup.action ? <div className="mt-3 flex flex-wrap items-center gap-2">
+          {popup.onRetry ? <button type="button" onClick={popup.onRetry} className="min-h-11 rounded-lg bg-obligon-green px-4 text-sm font-bold text-white hover:bg-[#315600] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-obligon-green">{popup.retryLabel ?? "Try again"}</button> : null}
+          {popup.action}
+        </div> : null}
+      </div>
+      {popup.dismissible !== false ? <button type="button" onClick={onDismiss} aria-label="Dismiss notification" className="-mr-2 -mt-2 grid size-11 shrink-0 place-items-center rounded-lg text-obligon-text hover:bg-obligon-panel focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-obligon-green"><X size={17} aria-hidden="true" /></button> : null}
+    </section>
+  );
+}
+
+function PopupStack({ children }: { children: React.ReactNode }) {
+  return <div data-status-popup-stack className="pointer-events-none fixed right-3 top-[calc(5rem+env(safe-area-inset-top))] z-[120] flex max-h-[calc(100dvh-11rem)] w-[min(calc(100vw-1.5rem),400px)] flex-col gap-3 overflow-y-auto overscroll-contain sm:right-5 sm:top-5">{children}</div>;
+}
+
+export function StatusPopupProvider({ children }: { children: React.ReactNode }) {
+  const [items, setItems] = React.useState<PopupItem[]>([]);
+  const hostKeys = React.useRef(new WeakMap<HTMLElement, string>());
+  const nextHostKey = React.useRef(0);
+  const register = React.useCallback((item: PopupItem) => {
+    setItems(previous => {
+      const existing = previous.find(value => value.id === item.id);
+      if (existing && existing.host === item.host && sameFeedback(existing, item)) return previous;
+      const next = { ...item, dismissed: existing && sameNoticeState(existing, item) ? existing.dismissed : false };
+      return existing ? previous.map(value => value.id === item.id ? next : value) : [...previous, next];
+    });
+  }, []);
+  const remove = React.useCallback((id: string) => setItems(previous => previous.some(item => item.id === id) ? previous.filter(item => item.id !== id) : previous), []);
+  const context = React.useMemo(() => ({ register, remove }), [register, remove]);
+  const groups = groupFeedback(items);
+  const hosts = Array.from(new Set(groups.map(item => item.host)));
+  function dismiss(ids: string[]) {
+    setItems(previous => previous.map(item => ids.includes(item.id) ? { ...item, dismissed: true } : item));
+  }
+  return <PopupContext.Provider value={context}>
+    {children}
+    {hosts.map(host => {
+      if (!hostKeys.current.has(host)) hostKeys.current.set(host, `status-popup-${++nextHostKey.current}`);
+      const local = groups.filter(item => item.host === host);
+      const progress = local.filter(isProgress);
+      const visible = [...local.filter(item => !isProgress(item)).slice(0, 2), ...progress.slice(0, 1)];
+      const hidden = local.filter(item => !isProgress(item)).length - visible.filter(item => !isProgress(item)).length;
+      return createPortal(<PopupStack>
+        {visible.map(item => <PopupCard key={item.id} popup={item} onDismiss={() => dismiss(isProgress(item) ? progress.flatMap(group => group.ids) : item.ids)} otherProgress={isProgress(item) ? progress.reduce((count, group) => count + group.ids.length, 0) - 1 : 0} />)}
+        {hidden > 0 ? <p role="status" className="rounded-lg border border-obligon-border bg-white px-4 py-2 text-xs font-semibold leading-5 text-obligon-text">{hidden} more {hidden === 1 ? "update" : "updates"}. Dismiss a notification to view.</p> : null}
+      </PopupStack>, host, hostKeys.current.get(host));
+    })}
+  </PopupContext.Provider>;
+}
+
+/** Feedback lasts only as long as its owning state, without changing the request. */
+export function StatusPopup(props: StatusPopupProps) {
+  const context = React.useContext(PopupContext);
+  const id = React.useId();
+  const anchor = React.useRef<HTMLSpanElement>(null);
+  const [dismissed, setDismissed] = React.useState(false);
+  const [host, setHost] = React.useState<HTMLElement | null>(null);
+  const { tone, title, message, onRetry, retryLabel, action, dismissible, icon } = props;
+  React.useEffect(() => {
+    setDismissed(false);
+  }, [tone, title, message, retryLabel, dismissible, icon]);
+  React.useEffect(() => {
+    const target = anchor.current?.closest<HTMLElement>('[role="dialog"], dialog[open]') ?? document.body;
+    if (context) context.register({ id, host: target, tone, title, message, onRetry, retryLabel, action, dismissible, icon });
+    else setHost(target);
+  }, [context, id, tone, title, message, onRetry, retryLabel, action, dismissible, icon]);
+  React.useEffect(() => () => context?.remove(id), [context, id]);
+  const fallback = !context && !dismissed ? <PopupStack><PopupCard popup={props} onDismiss={() => setDismissed(true)} /></PopupStack> : null;
+  return <>
+    <span ref={anchor} hidden aria-hidden="true" data-feedback-anchor />
+    {host && fallback ? createPortal(fallback, host) : fallback}
+  </>;
+}
diff --git a/apps/web/lib/auth-methods.ts b/apps/web/lib/auth-methods.ts
new file mode 100644
index 0000000..bfa044a
--- /dev/null
+++ b/apps/web/lib/auth-methods.ts
@@ -0,0 +1,76 @@
+import type { startAuthentication, startRegistration } from "@simplewebauthn/browser";
+
+export type PasskeyAuthenticationOptions = Parameters<typeof startAuthentication>[0]["optionsJSON"];
+export type PasskeyRegistrationOptions = Parameters<typeof startRegistration>[0]["optionsJSON"];
+export type PasskeyAuthenticationCredential = Awaited<ReturnType<typeof startAuthentication>>;
+export type PasskeyRegistrationCredential = Awaited<ReturnType<typeof startRegistration>>;
+
+export interface AuthMethodsConfig {
+  google: { enabled: boolean; clientId?: string };
+  passkeys: { enabled: boolean; rpName: string };
+}
+export interface GoogleChallenge { challengeId: string; clientId: string; nonce: string }
+export interface SignInMethods {
+  google: { enabled: boolean; linked: boolean };
+  passkeys: Array<{ id: string; label: string; createdAt: string; lastUsedAt: string | null; deviceType: string; backedUp: boolean }>;
+}
+
+export function passkeySupportError(): string | null {
+  if (typeof window === "undefined" || !window.isSecureContext) return "Passkeys need a secure connection. Open this site with HTTPS.";
+  if (typeof window.PublicKeyCredential === "undefined") return "This browser does not support passkeys. Try a current browser or sign in with your password.";
+  return null;
+}
+
+export async function authenticateWithPasskey(optionsJSON: PasskeyAuthenticationOptions): Promise<PasskeyAuthenticationCredential> {
+  const unsupported = passkeySupportError();
+  if (unsupported) throw new Error(unsupported);
+  const { startAuthentication: authenticate } = await import("@simplewebauthn/browser");
+  return authenticate({ optionsJSON });
+}
+
+export async function registerDevicePasskey(optionsJSON: PasskeyRegistrationOptions): Promise<PasskeyRegistrationCredential> {
+  const unsupported = passkeySupportError();
+  if (unsupported) throw new Error(unsupported);
+  const { startRegistration: register } = await import("@simplewebauthn/browser");
+  return register({ optionsJSON });
+}
+
+export function authMethodError(error: unknown): string {
+  const detail = error as { name?: string; code?: string; cause?: { name?: string } } | null;
+  const name = detail?.cause?.name ?? detail?.name ?? "";
+  if (name === "NotAllowedError" || name === "AbortError" || detail?.code === "ERROR_CEREMONY_ABORTED") return "The passkey request was cancelled or timed out. Try again or use your password.";
+  if (name === "InvalidStateError") return "This passkey is already registered. Choose another passkey or use one you have already added.";
+  if (name === "SecurityError") return "The passkey could not be used on this site. Check that you opened the correct HTTPS address.";
+  return error instanceof Error ? error.message : "We could not complete that request. Please try again.";
+}
+
+export interface GoogleIdentityApi {
+  initialize(options: { client_id: string; nonce: string; callback: (response: { credential?: string }) => void; auto_select: false; ux_mode: "popup" }): void;
+  renderButton(element: HTMLElement, options: { type: "standard"; theme: "outline"; size: "large"; text: "signin_with" | "continue_with"; shape: "rectangular"; width: number }): void;
+}
+
+let googleLoading: Promise<GoogleIdentityApi> | null = null;
+const googleScriptUrl = "https://accounts.google.com/gsi/client";
+
+export function loadGoogleIdentity(): Promise<GoogleIdentityApi> {
+  const current = () => (window as unknown as { google?: { accounts?: { id?: GoogleIdentityApi } } }).google?.accounts?.id;
+  if (typeof window === "undefined") return Promise.reject(new Error("Google sign-in is only available in a browser."));
+  const ready = current();
+  if (ready) return Promise.resolve(ready);
+  if (googleLoading) return googleLoading;
+  googleLoading = new Promise<GoogleIdentityApi>((resolve, reject) => {
+    const script = document.createElement("script");
+    const timer = window.setTimeout(() => { script.remove(); googleLoading = null; reject(new Error("Google sign-in took too long to load. Please try again.")); }, 15000);
+    script.src = googleScriptUrl;
+    script.async = true;
+    script.onload = () => {
+      window.clearTimeout(timer);
+      const api = current();
+      if (api) resolve(api);
+      else { googleLoading = null; reject(new Error("Google sign-in did not load. Please try again.")); }
+    };
+    script.onerror = () => { window.clearTimeout(timer); script.remove(); googleLoading = null; reject(new Error("Google sign-in could not load. Check your connection and try again.")); };
+    document.head.appendChild(script);
+  });
+  return googleLoading;
+}
diff --git a/apps/web/lib/dashboard-search.ts b/apps/web/lib/dashboard-search.ts
new file mode 100644
index 0000000..ba51ccb
--- /dev/null
+++ b/apps/web/lib/dashboard-search.ts
@@ -0,0 +1,94 @@
+import { api } from './services/client';
+import type { SessionUser } from './services/types';
+import { partnerAllowedFuels } from '../../../packages/shared/partner-access.mjs';
+
+export type DashboardSearchScope = 'customer' | 'company' | 'partner' | 'admin';
+export type DashboardSearchResult = { id: string; label: string; description?: string; href: string; kind?: string };
+
+export class DashboardSearchUnavailableError extends Error {
+  constructor(public results: DashboardSearchResult[], public unavailable: string[], message = 'Some records could not be searched. You can still use the available results and pages.') {
+    super(message);
+    this.name = 'DashboardSearchUnavailableError';
+  }
+}
+
+type RecordRow = Record<string, unknown>;
+type Source = { name: string; path: string; field: string; href: string; kind: string; title: (row: RecordRow) => string; token: (row: RecordRow) => string };
+const text = (value: unknown) => typeof value === 'string' ? value.trim() : '';
+const line = (value: unknown, index = 0) => text(value).split('\n')[index]?.trim() ?? '';
+const cell = (row: RecordRow, index: number) => Array.isArray(row.cells) ? text(row.cells[index]) : '';
+const reference = (row: RecordRow) => text(row.reference) || cell(row, 0);
+const staffName = (row: RecordRow) => line(cell(row, 1), 1) || line(cell(row, 1));
+const queryString = (query: string) => new URLSearchParams({ search: query, limit: '6', offset: '0' }).toString();
+
+function sources(scope: DashboardSearchScope, query: string, user: SessionUser): Source[] {
+  const params = queryString(query);
+  if (scope === 'customer') return [
+    { name: 'Recent transactions', path: '/api/customer/transactions?limit=50&offset=0', field: 'transactions', href: '/customer/transactions', kind: 'Transaction', title: reference, token: reference },
+    { name: 'Stations', path: `/api/customer/stations?${params}`, field: 'stations', href: '/customer/stations', kind: 'Station', title: row => text(row.name), token: row => text(row.name) }
+  ];
+  if (scope === 'company') return [
+    { name: 'Vehicles', path: `/api/company/vehicles?${params}`, field: 'vehicles', href: '/company/vehicles', kind: 'Vehicle', title: row => text(row.plate), token: row => text(row.plate) },
+    { name: 'Cards', path: `/api/company/cards?${params}`, field: 'cards', href: '/company/cards', kind: 'Card', title: row => line(cell(row, 0)), token: row => cell(row, 1) || line(cell(row, 0)) },
+    { name: 'Transactions', path: `/api/company/transactions?${params}`, field: 'transactions', href: '/company/transactions', kind: 'Transaction', title: reference, token: reference }
+  ];
+  if (scope === 'admin') return [
+    { name: 'Companies', path: `/api/admin/companies?${params}`, field: 'companies', href: '/admin', kind: 'Company', title: row => text(row.name) || line(cell(row, 0)), token: row => text(row.name) || line(cell(row, 0)) },
+    { name: 'Staff', path: `/api/admin/staff?${params}`, field: 'staff', href: '/admin/staff', kind: 'Staff member', title: row => text(row.name) || line(cell(row, 0)), token: row => text(row.name) || line(cell(row, 0)) },
+    { name: 'Disputes', path: `/api/admin/disputes?${params}`, field: 'disputes', href: '/admin/disputes', kind: 'Dispute', title: row => text(row.subject) || reference(row), token: reference }
+  ];
+  const staff: Source = { name: 'Staff', path: '/api/partner/staff', field: 'staff', href: '/dashboard/staff', kind: 'Staff member', title: staffName, token: row => cell(row, 0) };
+  if (!partnerAllowedFuels(user).length) return [staff];
+  return [
+    { name: 'Transactions', path: `/api/partner/transactions?${params}`, field: 'transactions', href: '/dashboard/transactions', kind: 'Transaction', title: reference, token: reference },
+    staff,
+    { name: 'Recent disputes', path: '/api/partner/disputes', field: 'disputes', href: '/dashboard/disputes', kind: 'Dispute', title: row => text(row.subject) || reference(row), token: reference }
+  ];
+}
+
+function allowed(scope: DashboardSearchScope, user: SessionUser | null | undefined): user is SessionUser {
+  if (!['customer', 'company', 'partner', 'admin'].includes(scope) || !user?.id) return false;
+  if (scope === 'admin') return user.role === 'admin';
+  if (scope === 'customer') return user.role === 'customer';
+  if (scope === 'company') return user.organizationType === 'company' && Boolean(user.organizationId && user.organizationRole);
+  return ['partner', 'mechanic'].includes(user.role) && ['partner', 'mechanic'].includes(user.organizationType ?? '') && Boolean(user.organizationId);
+}
+
+/** Search existing authorized lists only. Unfiltered endpoints cover recent records, not an entire account history. */
+export async function searchDashboardRecords(scope: DashboardSearchScope, query: string, user: SessionUser | null | undefined): Promise<DashboardSearchResult[]> {
+  if (!allowed(scope, user)) throw new DashboardSearchUnavailableError([], ['Account access'], 'This search is not available for the current account.');
+  const term = query.trim();
+  if (term.length < 2) return [];
+  if (term.length > 80) throw new DashboardSearchUnavailableError([], ['Search'], 'Use 80 characters or fewer to search.');
+  if (scope === 'company' && user.organizationVerificationStatus !== 'verified') throw new DashboardSearchUnavailableError([], ['Company records'], 'Company records become available after your contract is approved. You can still search available pages.');
+  const selected = sources(scope, term, user), needle = term.toLowerCase();
+  const settled = await Promise.allSettled(selected.map(async source => {
+    const data = await api.request<Record<string, unknown>>(source.path);
+    if (!data || !Array.isArray(data[source.field])) throw new Error('The record list could not be read.');
+    const results: DashboardSearchResult[] = [];
+    const seen = new Set<string>();
+    let malformed = false;
+    for (const item of (data[source.field] as unknown[]).slice(0, 100)) {
+      if (!item || typeof item !== 'object' || Array.isArray(item)) { malformed = true; continue; }
+      const row = item as RecordRow, id = text(row.id), label = source.title(row), token = source.token(row);
+      if (!id || !label || !token) { malformed = true; continue; }
+      const values = Object.values(row).flatMap(value => Array.isArray(value) ? value.filter(v => typeof v === 'string') : typeof value === 'string' ? [value] : []);
+      if (!values.join(' ').toLowerCase().includes(needle)) continue;
+      const resultId = `${source.kind}:${id}`;
+      if (seen.has(resultId)) continue;
+      seen.add(resultId);
+      results.push({ id: resultId, label: label.replace(/\s+/g, ' ').slice(0, 140),
+        description: [source.kind, text(row.status)].filter(Boolean).join(' · ').replace(/\s+/g, ' ').slice(0, 180),
+        href: `${source.href}?${new URLSearchParams({ search: token }).toString()}`, kind: source.kind });
+      if (results.length === 4) break;
+    }
+    return { results, malformed };
+  }));
+  const results: DashboardSearchResult[] = [], unavailable: string[] = [];
+  settled.forEach((entry, index) => {
+    if (entry.status === 'rejected') unavailable.push(selected[index].name);
+    else { results.push(...entry.value.results); if (entry.value.malformed) unavailable.push(selected[index].name); }
+  });
+  if (unavailable.length) throw new DashboardSearchUnavailableError(results.slice(0, 12), unavailable);
+  return results.slice(0, 12);
+}
diff --git a/apps/web/lib/partner-selling-unit.ts b/apps/web/lib/partner-selling-unit.ts
