+  const exports = {};
+  const code = ts.transpileModule(fs.readFileSync(require.resolve(file), 'utf8') + expose, { compilerOptions: { module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.React, esModuleInterop: true } }).outputText;
