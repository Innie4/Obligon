# ==============================================================================
# OBLIGON WEB — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy to `apps/web/.env.local` and fill in. Restart `pnpm dev` after changes.
#
# REQUIRED FOR LIVE FRONTEND QA:
#   NEXT_PUBLIC_API_URL and NEXT_PUBLIC_APP_URL
#   NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Optional: Maps and Web Push keys. Keep mock mode false for QA/UAT.

# ------------------------------------------------------------------------------
# API CONNECTION  (live mode activates automatically when this is set)
# ------------------------------------------------------------------------------
# Local: http://localhost:4000
# Vercel production API:
NEXT_PUBLIC_API_URL=https://obligon.onrender.com
NEXT_PUBLIC_APP_URL=https://obligon.vercel.app
# Explicitly opt into fixture data for isolated UI work. Keep false for QA/UAT.
NEXT_PUBLIC_ENABLE_MOCK_MODE=false

# ------------------------------------------------------------------------------
# DEMO ACCOUNTS — one-click sign-in for the five roles
# ------------------------------------------------------------------------------
# When true, the sign-in page shows a panel with one button per role (admin,
# customer, fleet/company, partner, mechanic). Each signs in and lands on that
# role's dashboard without typing anything.
#
# OFF by default, and it should stay off anywhere real users sign in. The five
# accounts share published passwords and have no second factor, and this is a
# NEXT_PUBLIC_ variable — so setting it puts every one of those passwords into
# the JavaScript bundle, readable by anyone who loads the page. That is fine for
# a demo and is a published admin password everywhere else.
#
# The API refuses to create these accounts when NODE_ENV=production
# (`pnpm --filter @obligon/api seed:demo` exits 1), so a deployment that sets
# this without seeding gets buttons that cannot work rather than working
# credentials that should not exist.
#
# Set true in development. Do not set it in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# GOOGLE MAPS — interactive station map with live markers
#   Console: https://console.cloud.google.com → Maps Platform → Credentials
#   Enable "Maps JavaScript API"; restrict the key to your domains.
#   Leave empty to use the OpenStreetMap fallback (still fully functional).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<YOUR-BROWSER-MAPS-KEY>

# ------------------------------------------------------------------------------
# WEB PUSH — must match the API's WEB_PUSH_VAPID_PUBLIC_KEY
#   Generate with:  npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=<YOUR-VAPID-PUBLIC-KEY>

# ------------------------------------------------------------------------------
# SUPABASE (browser-side, optional) — required only for direct Supabase client
# features such as Realtime. The API remains the server-side data boundary.
# The publishable key is safe for browser use; never place a service-role key here.
# Project Settings → API → Project URL / publishable key.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<YOUR-PUBLISHABLE-KEY>
# Legacy Supabase projects may still expose an anon key under this name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-ANON-JWT-HERE