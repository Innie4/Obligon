# ==============================================================================
# OBLIGON WEB — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy to `apps/web/.env.local` and fill in. Restart `pnpm dev` after changes.

# ------------------------------------------------------------------------------
# API CONNECTION  (live mode activates automatically when this is set)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Explicitly opt into fixture data for isolated UI work. Keep false for QA/UAT.
NEXT_PUBLIC_ENABLE_MOCK_MODE=false

# ------------------------------------------------------------------------------
# GOOGLE MAPS — interactive station map with live markers
#   Console: https://console.cloud.google.com → Maps Platform → Credentials
#   Enable "Maps JavaScript API"; restrict the key to your domains.
#   Leave empty to use the OpenStreetMap fallback (still fully functional).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<YOUR-BROWSER-MAPS-KEY>

# ------------------------------------------------------------------------------
# WEB PUSH — must match the API's WEB_PUSH_VAPID_PUBLIC_KEY
#   Generate with:  npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=<YOUR-VAPID-PUBLIC-KEY>

# ------------------------------------------------------------------------------
# SUPABASE (browser-side, optional) — only needed if you add direct Supabase
# client features (e.g. Realtime subscriptions) later. The API already proxies
# everything, so these are safe to leave as placeholders.
# Project Settings → API → Project URL / anon public key.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-ANON-JWT-HERE
