# ==============================================================================
# OBLIGON API — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to `apps/api/.env` and replace every YOUR_* / example value.
# Values in <angle brackets> are placeholders — replace them with your real
# credentials. Nothing else needs to change.
#
# STEP-BY-STEP (10 minutes):
#   1. Create a project at https://supabase.com/dashboard  → copy ① ② ③ ④
#   2. Generate the two JWT secrets (⑤ ⑥):      openssl rand -hex 32
#   3. (Optional) Sudo Africa / Paystack / Resend / Termii / Google keys
#   4. Run:  pnpm migrate  →  pnpm seed  →  pnpm dev:api
#
# `GET /health` on the running API tells you exactly which providers it
# detected. Missing optional keys degrade gracefully (simulated outcomes are
# recorded in audit_logs) — only DATABASE_URL is mandatory.
# ==============================================================================

# ------------------------------------------------------------------------------
# APP
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the frontend (used in emails + Paystack callbacks)
APP_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# ① SUPABASE DATABASE  (Project Settings → Database → Connection string → URI)
# ------------------------------------------------------------------------------
# Use the "Session pooler" URI for the API. Format:
#   postgresql://postgres.<PROJECT-REF>:<YOUR-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# Example filled in:
#   postgresql://postgres.abcdefghijklmnop:SuperSecret123@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<YOUR-DATABASE-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# ② SUPABASE PROJECT URL  (Project Settings → API → Project URL)
# ------------------------------------------------------------------------------
# Example filled in: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://<PROJECT-REF>.supabase.co

# ------------------------------------------------------------------------------
# ③ SUPABASE SERVICE ROLE KEY  (Project Settings → API → service_role secret)
#   ⚠ Server-side ONLY. Never expose this to the browser.
#   Example shape: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3AiLCJyb2xlIjoic2VydmljZV9yb2xlIn0.<signature>
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-SERVICE-ROLE-JWT-HERE

# ------------------------------------------------------------------------------
# ④ SUPABASE ANON KEY  (Project Settings → API → anon public)
#   Used as the apikey header when validating passwords against Supabase Auth.
#   Same JWT shape as above but with role "anon".
# ------------------------------------------------------------------------------
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-ANON-JWT-HERE

# Supabase Auth (GoTrue) integration.
#   true  → passwords live in Supabase Auth; login/signup/reset are validated
#           against it, and the seed creates auth users for the demo accounts.
#   false → passwords are hashed locally with bcrypt (works with just ①).
# Requires ② ③ to be set when true.
SUPABASE_AUTH_ENABLED=true

# Background scheduler: purges expired sessions/verification codes and runs
# auto-settlement for partners that enabled it. Enable in production
# (or run `pnpm --filter @obligon/api cron` as a scheduled job instead).
ENABLE_SCHEDULER=false

# Refuse provider-backed financial/card operations when credentials are absent.
# Keep true for QA, staging, and production. Provider doubles belong in tests.
STRICT_PROVIDERS=true

# Storage bucket created automatically for receipts, invoices, evidence, resumes
# and station assets (private bucket, signed-URL downloads).
SUPABASE_STORAGE_BUCKET=obligon

# ------------------------------------------------------------------------------
# ⑤ ⑥ AUTH SECRETS   (generate both with:  openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=<RUN-openssl-rand-hex-32-and-paste-1>
JWT_REFRESH_SECRET=<RUN-openssl-rand-hex-32-and-paste-2>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_REFRESH_TTL_DAYS=30

# ------------------------------------------------------------------------------
# ⑦ SUDO AFRICA — virtual fuel-card issuing   (https://console.sudo.africa)
#    Sandbox keys: console → Settings → API Keys (Sandbox)
#    Base URL: sandbox https://api.sandbox.sudo.africa/v1
#              live    https://api.sudo.africa/v1
#    Register webhook: <APP_URL>/api/webhooks/sudo   (HMAC-SHA256, secret below)
#    Example key shape: SUDO-SECRET-7f3a9c2e8b1d4a6f9e0c3b5a7d2f4h6j
# ------------------------------------------------------------------------------
SUDO_BASE_URL=https://api.sandbox.sudo.africa/v1
SUDO_SECRET_API_KEY=<YOUR-SUDO-SECRET-API-KEY>
SUDO_WEBHOOK_SECRET=<YOUR-SUDO-WEBHOOK-SIGNING-SECRET>

# ------------------------------------------------------------------------------
# ⑧ PAYSTACK — top-ups, subscriptions, payouts   (https://dashboard.paystack.com)
#    Settings → API Keys & Webhooks. Test keys start sk_test_ / pk_test_.
#    Register webhook: <APP_URL>/api/webhooks/paystack
#    (signature = HMAC-SHA512 of raw body with the SECRET key — auto-verified)
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_<YOUR-PAYSTACK-SECRET-KEY>
PAYSTACK_PUBLIC_KEY=pk_test_<YOUR-PAYSTACK-PUBLIC-KEY>

# ------------------------------------------------------------------------------
# ⑨ RESEND — transactional email   (https://resend.com → API Keys)
#    Verify your sending domain first; EMAIL_FROM must use that domain.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_<YOUR-RESEND-API-KEY>
EMAIL_FROM=Obligon <no-reply@obligon.com>

# ------------------------------------------------------------------------------
# ⑩ TERMII — SMS / OTP   (https://sms.termii.com → Settings → API Key)
# ------------------------------------------------------------------------------
TERMII_API_KEY=TL<YOUR-TERMII-API-KEY>
TERMII_SENDER_ID=Obligon

# ------------------------------------------------------------------------------
# ⑪ WEB PUSH (VAPID)   (generate with:  npx web-push generate-vapid-keys)
#    Put the PUBLIC key in apps/web/.env.local too (NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY).
# ------------------------------------------------------------------------------
WEB_PUSH_VAPID_PUBLIC_KEY=<YOUR-VAPID-PUBLIC-KEY>
WEB_PUSH_VAPID_PRIVATE_KEY=<YOUR-VAPID-PRIVATE-KEY>
WEB_PUSH_CONTACT=mailto:ops@obligon.com

# ------------------------------------------------------------------------------
# ⑫ GOOGLE MAPS PLATFORM   (https://console.cloud.google.com → Maps Platform)
#    Enable: Maps JavaScript API, Geocoding API, Directions API.
#    Server key (no restrictions) + browser key (HTTP-referrer restricted).
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=<YOUR-SERVER-MAPS-KEY>
