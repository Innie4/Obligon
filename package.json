{
  "name": "obligon-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @obligon/web dev",
    "dev:api": "pnpm --filter @obligon/api dev",
    "build": "pnpm --filter @obligon/web build",
    "start": "pnpm --filter @obligon/api start",
    "lint": "pnpm --filter @obligon/web lint",
    "migrate": "pnpm --filter @obligon/api migrate",
    "seed": "pnpm --filter @obligon/api seed",
    "test:api": "pnpm --filter @obligon/api test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
